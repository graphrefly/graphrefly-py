from collections.abc import Callable
from typing import Any

class Graph:
    def __init__(self, name: str | None = None) -> None: ...
    def checkpoint(self) -> dict[str, Any]: ...
    def state(self, value: object, name: str | None = None) -> Node: ...
    def state_empty(self, name: str | None = None) -> Node: ...
    def _wire_bridge(self, session_id: str, name: str | None = None) -> _WireBridge: ...
    def _wire_bridge_protobuf(
        self,
        bridge: _WireBridge,
        name: str | None = None,
    ) -> _WireBridgeProtobuf: ...
    def _wire_edge_group(
        self,
        bridge: _WireBridge,
        inbound_edges: list[str],
        name: str | None = None,
    ) -> _WireEdgeGroup: ...
    def _wire_edge_group_outbound(
        self,
        bridge: _WireBridge,
        outbound_edges: list[tuple[str, Node]],
        name: str | None = None,
    ) -> _WireEdgeGroup: ...
    def _wire_bridge_ack_driver(
        self,
        bridge: _WireBridge,
        clock: Node,
        timeout_ms: int,
        name: str | None = None,
    ) -> _WireBridgeAckDriver: ...
    def producer(self, callback: Callable[[], object], name: str | None = None) -> Node: ...
    def node(
        self,
        deps: list[Node],
        callback: Callable[[Ctx], object],
        name: str | None = None,
        partial: bool = False,
        complete_when_deps_complete: bool = True,
        error_when_deps_error: bool = True,
        terminal_as_real_input: bool = False,
        pausable: str | None = None,
        pull_id: str | None = None,
        restore_ref: str | None = None,
        restore_config: object | None = None,
        restore_config_version: object | None = None,
    ) -> Node: ...
    def _conformance_node(
        self,
        deps: list[Node],
        callback: Callable[[Ctx], object],
        name: str | None = None,
        partial: bool = False,
        complete_when_deps_complete: bool = True,
        error_when_deps_error: bool = True,
        terminal_as_real_input: bool = False,
        pausable: str | None = None,
        pull_id: str | None = None,
    ) -> Node: ...
    def _conformance_async_node(
        self,
        deps: list[Node],
        name: str | None = None,
        pausable: str | None = None,
    ) -> tuple[Node, object]: ...
    def _conformance_async_source(
        self,
        name: str | None = None,
        pausable: str | None = None,
    ) -> tuple[Node, object]: ...
    def _async_source(
        self,
        callback: Callable[[AsyncCtx], object],
        name: str | None = None,
        pausable: str | None = None,
    ) -> Node: ...
    def _async_node(
        self,
        deps: list[Node],
        callback: Callable[..., object],
        name: str | None = None,
        pausable: str | None = None,
    ) -> Node: ...
    def derived(
        self,
        deps: list[Node],
        callback: Callable[..., object],
        name: str | None = None,
    ) -> Node: ...
    def effect(
        self,
        deps: list[Node],
        callback: Callable[..., object],
        name: str | None = None,
    ) -> Node: ...
    def batch(self, callback: Callable[[], object]) -> None: ...
    def describe(self) -> dict[str, Any]: ...
    def _find(self, id: str) -> Node | None: ...
    def _set_state_by_id(self, id: str, value: object) -> None: ...
    def observe(self, callback: Callable[[str, str, object, int, int], object]) -> Subscription: ...
    def raise_pending_fatal(self) -> None: ...

class Node:
    def set(self, value: object) -> None: ...
    def send(self, value: object) -> None: ...
    def pause(self, lock_id: str) -> None: ...
    def resume(self, lock_id: str) -> None: ...
    def invalidate(self) -> None: ...
    def _up_dirty(self) -> None: ...
    def _up_teardown(self) -> None: ...
    def _conformance_up_pull(self, pull_id: str, params: object | None = None) -> None: ...
    def _conformance_up_pull_toward(
        self,
        toward_dep: int,
        pull_id: str,
        params: object | None = None,
    ) -> None: ...
    def _conformance_up_data_forbidden(self, value: object) -> None: ...
    def _conformance_immediate_subscribe_dep(
        self,
        dep: Node,
        callback: Callable[[Ctx], object],
    ) -> None: ...
    def _conformance_immediate_unsubscribe_dep(
        self,
        dep: Node,
        callback: Callable[[Ctx], object],
    ) -> None: ...
    def _conformance_immediate_replace_deps(
        self,
        deps: list[Node],
        callback: Callable[[Ctx], object],
    ) -> None: ...
    def _conformance_c22_down_data(self, value: object) -> None: ...
    def _conformance_c21_replace_with_live_dep(
        self,
        dep: Node,
        async_handle: object,
    ) -> None: ...
    def _down_resolved(self) -> None: ...
    def _down_dirty(self) -> None: ...
    def _down_invalidate(self) -> None: ...
    def _down_data_data_invalidate(self, first: object, second: object) -> None: ...
    def _conformance_c12_down_data_resolved(self, value: object) -> None: ...
    def _down_data_complete(self, value: object) -> None: ...
    def _down_complete(self) -> None: ...
    def _down_teardown(self) -> None: ...
    def _down_error(self, message: str) -> None: ...
    def cache(self) -> object | None: ...
    def cache_entry(self) -> tuple[bool, object | None]: ...
    def status(self) -> str: ...
    def subscribe(self, callback: Callable[[str, object], object]) -> Subscription: ...

class Ctx:
    def dep_len(self) -> int: ...
    def data_entry(self, index: int) -> tuple[bool, object | None]: ...
    def wave_data(self, sentinel: object) -> list[list[list[object]]]: ...
    def terminal(self, index: int) -> bool | object: ...
    def emit(self, value: object) -> None: ...
    def state_entry(self) -> tuple[bool, object | None]: ...
    def set_state(self, value: object) -> None: ...
    def state_persist(self, on: bool = True) -> None: ...
    def on_invalidate(self, callback: Callable[[], object]) -> None: ...
    def on_deactivation(self, callback: Callable[[], object]) -> None: ...
    def _rewire_next_subscribe_dep(
        self,
        dep: Node,
        callback: Callable[[Ctx], object],
    ) -> None: ...
    def _rewire_next_unsubscribe_dep(
        self,
        dep: Node,
        callback: Callable[[Ctx], object],
    ) -> None: ...
    def _rewire_next_replace_deps(
        self,
        deps: list[Node],
        callback: Callable[[Ctx], object],
    ) -> None: ...
    def _pull_context(self) -> tuple[str, object | None] | None: ...
    def _up_next_pull(
        self,
        pull_id: str,
        params: object | None = None,
        toward_dep: int | None = None,
    ) -> None: ...
    def _up_pull(
        self,
        pull_id: str,
        params: object | None = None,
        toward_dep: int | None = None,
    ) -> None: ...
    def _conformance_up_data(self, value: object) -> None: ...
    def _conformance_down_complete(self) -> None: ...

class AsyncCtx:
    def emit(self, value: object) -> None: ...
    def complete(self) -> None: ...
    def resolve(self, value: object) -> None: ...
    def error(self, message: str) -> None: ...
    def is_live(self) -> bool: ...
    def on_deactivation(self, callback: Callable[[], object]) -> None: ...

class Subscription:
    def unsubscribe(self) -> None: ...

class CanonicalProtobufValidation:
    @property
    def ok(self) -> bool: ...
    @property
    def category(self) -> str | None: ...
    @property
    def message(self) -> str | None: ...

class CanonicalProtobufRoundtrip:
    @property
    def ok(self) -> bool: ...
    @property
    def bytes(self) -> bytes | None: ...
    @property
    def category(self) -> str | None: ...
    @property
    def message(self) -> str | None: ...

class _WireBridge:
    @property
    def status(self) -> Node: ...
    @property
    def issues(self) -> Node: ...
    def release(self) -> None: ...

class _WireBridgeProtobuf:
    @property
    def inbound_bytes(self) -> Node: ...
    @property
    def outbound_bytes(self) -> Node: ...
    @property
    def status(self) -> Node: ...
    @property
    def issues(self) -> Node: ...
    def release(self) -> None: ...

class _WireEdgeGroup:
    @property
    def inbound_edges(self) -> dict[str, Node]: ...
    @property
    def status(self) -> Node: ...
    @property
    def issues(self) -> Node: ...
    def release(self) -> None: ...

class _WireBridgeAckDriver:
    @property
    def timeouts(self) -> Node: ...
    @property
    def status(self) -> Node: ...
    @property
    def issues(self) -> Node: ...
    def release(self) -> None: ...

class RestoreContext:
    @property
    def id(self) -> str: ...
    @property
    def name(self) -> str | None: ...
    @property
    def deps(self) -> list[str]: ...
    @property
    def config(self) -> object | None: ...
    @property
    def config_version(self) -> object | None: ...
    @property
    def checkpoint(self) -> dict[str, Any]: ...
    def register_state(self) -> None: ...
    def register_node(
        self,
        callback: Callable[[Ctx], object],
        factory: str | None = None,
    ) -> None: ...

class RestoreRegistry: ...

def restore_registry(
    entries: list[object],
    include_builtins: bool = True,
) -> RestoreRegistry: ...
def restore_graph(checkpoint: object, registry: RestoreRegistry) -> Graph: ...
def _validate_canonical_wire_bridge_envelope(
    bytes: bytes,
) -> CanonicalProtobufValidation: ...
def _validate_canonical_wire_edge_frame(
    bytes: bytes,
) -> CanonicalProtobufValidation: ...
def _roundtrip_canonical_wire_bridge_envelope(
    bytes: bytes,
) -> CanonicalProtobufRoundtrip: ...
def _roundtrip_canonical_wire_edge_frame(
    bytes: bytes,
) -> CanonicalProtobufRoundtrip: ...
def version() -> str: ...
